          %21 = arith.addi %arg10, %19 : index
          %22 = arith.cmpi slt, %arg7, %21 : index
          %23 = arith.andi %20, %22 : i1
          %24 = arith.select %23, %arg8, %arg9 : index
          %25 = arith.subi %arg7, %arg10 : index
          %26 = arith.select %23, %25, %arg11 : index
          %27 = arith.addi %arg10, %19 : index
          scf.yield %24, %27, %26 : index, index, index
        }
        %12:3 = scf.for %arg8 = %c0 to %c2 step %c1 iter_args(%arg9 = %c0, %arg10 = %c0, %arg11 = %c0) -> (index, index, index) {
          %19 = arith.muli %arg8, %c2_0 : index
          %20 = arith.addi %19, %11#0 : index
          %21 = pto.load_scalar %arg5[%20] : !pto.ptr<i32> -> i32
          %22 = arith.index_cast %21 : i32 to index
          %23 = arith.cmpi sge, %11#2, %arg11 : index
          %24 = arith.addi %arg11, %22 : index
          %25 = arith.cmpi slt, %11#2, %24 : index
          %26 = arith.andi %23, %25 : i1
          %27 = arith.select %26, %arg8, %arg10 : index
          %28 = arith.subi %11#2, %arg11 : index
