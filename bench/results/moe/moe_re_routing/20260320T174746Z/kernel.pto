          %13 = arith.muli %arg8, %c2_0 : index
          %14 = arith.addi %13, %arg7 : index
          %15 = pto.load_scalar %arg5[%14] : !pto.ptr<i32> -> i32
          %16 = arith.index_cast %15 : i32 to index
          %17 = arith.addi %arg9, %16 : index
          scf.yield %17 : index
        }
        %12 = arith.index_cast %11 : index to i32
        pto.store_scalar %12, %arg3[%arg7] : !pto.ptr<i32>, i32
      }
      scf.for %arg7 = %7 to %9 step %c1 {
        %11:3 = scf.for %arg8 = %c0 to %c2_0 step %c1 iter_args(%arg9 = %c0, %arg10 = %c0, %arg11 = %c0) -> (index, index, index) {
          %19 = scf.for %arg12 = %c0 to %c2 step %c1 iter_args(%arg13 = %c0) -> (index) {
            %28 = arith.muli %arg12, %c2_0 : index
            %29 = arith.addi %28, %arg8 : index
            %30 = pto.load_scalar %arg5[%29] : !pto.ptr<i32> -> i32
            %31 = arith.index_cast %30 : i32 to index
            %32 = arith.addi %arg13, %31 : index
            scf.yield %32 : index
